#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  ssh:
    install-server: true
    allow-pw: true
  identity:
    hostname: ubuntu-template
    username: ubuntu
    # mkpasswd -m sha-512 'packer' で生成。下は 'packer' のハッシュ例なので必ず作り直す
    password: "$6$RiRuUxDVilFvNEG6$RL/YcAQ8GO.uIwo0RPQVzgq5R/i4Q91RAFconirB.abtUOvhq64FfCjuxFC4PecCSxPojPKSvyhYp5Bw/uCH/1"
  storage:
    layout:
      name: lvm
  packages:
    - qemu-guest-agent
  user-data:
    disable_root: false
  late-commands:
    # sudo パスワードレス（Packer の provisioner 用）
    - echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/ubuntu
