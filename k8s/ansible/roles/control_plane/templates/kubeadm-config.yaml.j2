# kubeadm の初期化設定。
# CIDR は group_vars/all.yml を唯一の定義元とし、Cilium の values とも共有する。
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ k8s_control_plane_ip }}
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ k8s_package_version | regex_replace('-.*$', '') }}
# 単一ホスト構成のため control-plane は冗長化しない。
# 将来 HA 化する場合に備え、エンドポイントは明示しておく。
controlPlaneEndpoint: "{{ k8s_control_plane_ip }}:6443"
networking:
  podSubnet: {{ k8s_pod_cidr }}
  serviceSubnet: {{ k8s_service_cidr }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
# containerd 側の SystemdCgroup = true と揃える必要がある
cgroupDriver: systemd
