# ArgoCD を共有 Gateway 経由で公開する。
# ArgoCD 自身は GitOps の起点なので、この Route だけは Ansible で管理する。
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd
  namespace: argocd
spec:
  parentRefs:
    - name: shared-gateway
      namespace: {{ gateway_namespace }}
      sectionName: https
  hostnames:
    - argocd.{{ cert_manager_dns_zone }}
  rules:
    - backendRefs:
        - name: argocd-server
          port: 80
---
# HTTP は HTTPS へ誘導する
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd-redirect
  namespace: argocd
spec:
  parentRefs:
    - name: shared-gateway
      namespace: {{ gateway_namespace }}
      sectionName: http
  hostnames:
    - argocd.{{ cert_manager_dns_zone }}
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
