# Cilium の設定。
# Pod CIDR は kubeadm の podSubnet と一致させる必要がある。
# 両者の定義元は group_vars/all.yml に集約している。

# kube-proxy の置き換え。
# Cilium の Gateway API が必須要件としているため有効化した。
# Service の実装が iptables から eBPF に変わる。
kubeProxyReplacement: {{ cilium_kube_proxy_replacement | lower }}

# kube-proxy 経由の解決に依存せず API サーバへ直接到達させる。
# 起動時のニワトリ卵問題を避けるための指定。
k8sServiceHost: {{ k8s_control_plane_ip }}
k8sServicePort: 6443

ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv4PodCIDRList:
      - {{ k8s_pod_cidr }}
    # /24 ずつノードに割り当てる(1ノードあたり最大254 Pod)
    clusterPoolIPv4MaskSize: 24

# 単一の L2 セグメント上なのでネイティブルーティングも選べるが、
# まずは前提の少ない VXLAN で確実に動かす。
routingMode: tunnel
tunnelProtocol: vxlan

operator:
  # 既定は2だが、3ノードの homelab では1で十分
  replicas: 1

# 通信の可視化。Cilium を選んだ主目的のひとつ。
hubble:
  enabled: true
  relay:
    enabled: true
  ui:
    enabled: true

# Gateway API コントローラ。
# ingress-nginx が 2026年3月に retire されたため、その代替として使う。
# CRD は別途適用済みであること。
gatewayAPI:
  enabled: true
