# 管理ホスト用の静的IP設定
network:
  version: 2
  renderer: networkd
  ethernets:
    enp0s31f6:
      dhcp4: false
      addresses:
        - 192.168.3.11/24
      routes:
        - to: default
          via: 192.168.3.1        # ルーターのIPに読み替えてください
      nameservers:
        # 起動時点ではAdGuard Homeは未稼働なので、まずは外部DNSを指定する
        addresses: [127.0.0.1]
