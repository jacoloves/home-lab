#!/bin/bash
# vzdump の最新バックアップの更新時刻とサイズを Prometheus に公開する。
# このファイルは Ansible が生成する(roles/monitoring/templates)。
set -euo pipefail

OUT={{ node_exporter_textfile_dir }}/vzdump.prom
TMP="${OUT}.$$"

{
  echo '# HELP vzdump_last_backup_timestamp_seconds 最新バックアップの更新時刻'
  echo '# TYPE vzdump_last_backup_timestamp_seconds gauge'
  echo '# HELP vzdump_last_backup_bytes 最新バックアップのサイズ'
  echo '# TYPE vzdump_last_backup_bytes gauge'

  for vmid in {{ vzdump_watch_vmids | join(' ') }}; do
    f=$(ls -t {{ vzdump_backup_dir }}/vzdump-qemu-${vmid}-*.vma.zst 2>/dev/null | head -1 || true)
    if [ -n "$f" ]; then
      printf 'vzdump_last_backup_timestamp_seconds{vmid="%s"} %s\n' "$vmid" "$(stat -c %Y "$f")"
      printf 'vzdump_last_backup_bytes{vmid="%s"} %s\n' "$vmid" "$(stat -c %s "$f")"
    else
      # ファイルが無い場合も 0 を出す。メトリクス欠損だとアラート式が
      # 評価されず「鳴らない」状態になるため。
      printf 'vzdump_last_backup_timestamp_seconds{vmid="%s"} 0\n' "$vmid"
      printf 'vzdump_last_backup_bytes{vmid="%s"} 0\n' "$vmid"
    fi
  done
} > "$TMP"

mv "$TMP" "$OUT"
